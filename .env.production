# Site options
PUBLIC_SITE_TITLE=GitBlog
PUBLIC_SITE_OWNER="GitBlog"
PUBLIC_SITE_IMAGE=
PUBLIC_SITE_URL=
PUBLIC_SITE_REPOSITORY=gitblogapp/svelte-gitblog-template
PUBLIC_SITE_TAGLINE="Write, translate, and publish from your GitHub repository."
PUBLIC_SITE_DESCRIPTION="GitBlog turns your GitHub repository into a multilingual blog. Write in Markdown, publish with GitHub Pages, and share your posts through GitBlog."
PUBLIC_SITE_FOOTER="Powered by gitblog"

# Hub options
PUBLIC_HUB_ENABLED=true
PUBLIC_ANALYTICS_ENABLED=true
PUBLIC_HUB_URL=https://gitblog.app
PUBLIC_RELATED_ENABLED=true
PUBLIC_RELATED_SHOW_THUMBNAIL=true
PUBLIC_RELATED_LIMIT=4

# Release options
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_RELEASE_USE_TRANSLATIONS=true
PUBLIC_SOURCE_LOCALE=en
PUBLIC_TRANSLATION_LOCALES=
PUBLIC_RELEASE_LOCALE=en

# Giscus options
PUBLIC_GISCUS_ENABLED=true
PUBLIC_GISCUS_REPO=gitblogapp/svelte-gitblog-template
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=General
PUBLIC_GISCUS_CATEGORY_ID=
PUBLIC_GISCUS_HOST=https://gitblog.app
PUBLIC_GISCUS_PROVIDER=gitblog

# Social options
PUBLIC_SOCIAL_X_URL=https://x.com/gitblogapp
PUBLIC_SOCIAL_GITHUB_URL=https://github.com/gitblogapp

# Crawl preferences (all allowed by default, matching previous releases).
# Google-Extended controls both Gemini training and supported grounding uses.
PUBLIC_AI_CHATGPT_SEARCH_ENABLED=true
PUBLIC_AI_CLAUDE_SEARCH_ENABLED=true
PUBLIC_AI_GOOGLE_EXTENDED_ENABLED=true
PUBLIC_AI_OPENAI_TRAINING_ENABLED=true
PUBLIC_AI_ANTHROPIC_TRAINING_ENABLED=true
PUBLIC_GOOGLE_SEARCH_ENABLED=true
PUBLIC_AI_MARKDOWN_ENABLED=true
PUBLIC_AI_LLMS_ENABLED=true

# CPU-generated Supertonic 3 audio. Per-post tts/ttsVoice override these defaults.
PUBLIC_TTS_ENABLED=false
PUBLIC_TTS_VOICE=F1
