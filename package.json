{
	"name": "blog",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run author:check && vite build && node ./scripts/build-cname.mjs && node ./scripts/validate-hub-contract.mjs && node ./scripts/audit-discovery.mjs && pagefind --site build",
		"preview": "node ./scripts/preview.mjs",
		"posts:ids": "node ./scripts/post-ids.mjs --write",
		"posts:ids:check": "node ./scripts/post-ids.mjs --check",
		"test:site-translations": "node ./tests/test-site-translations.mjs",
		"test:post-releases": "node ./tests/test-post-releases.mjs",
		"test:post-ids": "node ./tests/test-post-ids.mjs",
		"test:giscus-sync": "node ./tests/test-giscus-sync.mjs",
		"test:hub-hints": "node ./tests/test-hub-hints.mjs && node ./tests/test-blog-registration.mjs",
		"hub:validate": "node ./scripts/validate-hub-contract.mjs",
		"translate:content": "node ./scripts/sync-content.mjs",
		"content:prepare": "node ./scripts/sync-content.mjs --prepare",
		"author:context": "node ./scripts/authoring.mjs context",
		"author:new": "node ./scripts/authoring.mjs new",
		"author:status": "node ./scripts/authoring.mjs status",
		"author:translation": "node ./scripts/authoring.mjs translation",
		"author:check": "node ./scripts/authoring.mjs check",
		"author:verify": "node ./scripts/authoring.mjs verify",
		"author:deploy": "node ./scripts/authoring.mjs deploy",
		"author:deploy-status": "node ./scripts/authoring.mjs deploy-status",
		"test:authoring": "node ./tests/test-authoring.mjs",
		"test:authoring:build": "node ./tests/test-authoring-build.mjs",
		"translate:posts": "npm run translate:content",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run test:taxonomy && npm run test:discovery && npm run test:setup && npm run test:app-access && npm run test:authoring && npm run test:harness-docs && npm run author:check && npm run test:site-translations && npm run test:post-releases && npm run test:post-ids && npm run test:giscus-sync && npm run test:hub-hints && npm run test:preservation && npm run test:extensions && npm run test:analytics && npm run test:body-excerpt && npm run test:related-panel && npm run posts:ids:check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:preservation": "node ./tests/test-preservation.mjs",
		"test:extensions": "node ./tests/test-extensions.ts",
		"update:check": "node ./scripts/validate-update.mjs",
		"test:seo": "node ./tests/test-translated-seo.mjs",
		"test:template": "node ./tests/test-template-integration.mjs",
		"test:tts": "node ./tests/test-tts-translations.mjs && python3 -m unittest discover -s tests/tts -v",
		"test:history": "PYTHONPATH=scripts/history python3 -m unittest discover -s tests/history -p 'test_*.py' -v",
		"test:analytics": "node ./tests/test-analytics.ts",
		"test:body-excerpt": "node ./tests/test-body-excerpt.ts",
		"test:related-panel": "node ./tests/test-related-panel.ts",
		"site:setup": "node ./scripts/setup.mjs inspect",
		"site:configure": "node ./scripts/setup.mjs apply",
		"site:check": "node ./scripts/setup.mjs check",
		"site:pages": "node ./scripts/setup.mjs pages",
		"site:pages:status": "node ./scripts/setup.mjs pages-status",
		"test:setup": "node ./tests/test-setup.mjs",
		"discovery:check": "node ./scripts/audit-discovery.mjs",
		"test:discovery": "node --test tests/test-ai-policy.ts tests/test-discovery-audit.mjs",
		"test:harness-docs": "node ./tests/test-harness-docs.mjs",
		"taxonomy:sync": "node ./scripts/taxonomy.mjs",
		"taxonomy:check": "node ./scripts/taxonomy.mjs --check",
		"test:taxonomy": "node --test tests/test-taxonomy.ts",
		"site:app:status": "node ./scripts/setup.mjs app-status",
		"test:app-access": "node ./tests/test-app-access.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@types/node": "^24",
		"cheerio": "^1.2.0",
		"eslint": "^10.0.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"pagefind": "^1.5.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"robots-parser": "^3.0.1",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.0",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"gray-matter": "^4.0.3",
		"highlight.js": "^11.11.1",
		"marked": "^18.0.0"
	},
	"engines": {
		"node": ">=24.12.0"
	}
}
